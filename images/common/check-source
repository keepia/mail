#!/bin/sh
# check-source: unpacks a pinned source archive and checks that it holds
# exactly the pinned git tree (#44, #25, #55). ADD --checksum pins the
# archive's bytes; this check ties those bytes to the reviewed tree, taken
# from a clone of the upstream repository at the pinned commit or tag.
#
# Usage: check-source ARCHIVE MANIFEST DIR
# Unpacks ARCHIVE into DIR (without the archive's top directory) and fails
# unless DIR holds exactly the pinned tree: the same files with the same
# content and modes, the same directories, and nothing else.
#
# The archive is unpacked with umask 022 and --no-same-permissions, so no
# entry lands with a setuid, setgid or sticky bit or writable by group or
# others, whatever the archive says. The check then reads DIR's listing:
# one line per file or directory, sorted by path in the C locale
# (LC_ALL=C sort -t ' ' -k4), with one "\n" after each line:
#
#   f <mode> <sha256> <path>   a file: its octal mode (644 or 755 for a git
#                              blob) and the sha256 of its content
#   d <mode> - <path>          a directory (755), also an empty one, such as
#                              a submodule's in GitHub's archive
#
# scripts/source-listing.sh writes the same listing from a clone; see
# docs/development/index.md. Paths with a newline, a carriage return or a
# backslash are rejected on both sides (sha256sum escapes them, #59). The
# manifest is read before the check changes into DIR, so a relative path
# works, and an unreadable one fails. It has one of two forms:
#
# - the listing itself, after comment lines (#) (olefy). DIR's listing must
#   equal it; a mismatch prints a diff.
# - a digest, for trees of thousands of entries (SOPE, SOGo): comment lines
#   and one line "listing <sha256> <count>", the sha256 of the listing and
#   its number of lines. On a mismatch the check prints DIR's listing, so a
#   diff against one generated from the clone names the entry.
#
# A path may contain spaces. The Dockerfiles bind-mount this script for one
# RUN, so it is not in an image.
set -eu

if [ $# -ne 3 ]; then
	echo "usage: check-source ARCHIVE MANIFEST DIR" >&2
	exit 2
fi
archive=$1 manifest=$2 dir=$3

lists=$(mktemp -d)
trap 'rm -rf "$lists"' EXIT
trap 'exit 1' HUP INT TERM

# The manifest's lines without comments, read before the cd below (#59).
if [ ! -f "$manifest" ] || [ ! -r "$manifest" ]; then
	echo "check-source: cannot read the manifest $manifest" >&2
	exit 1
fi
grep -v '^#' "$manifest" >"$lists/want" || [ $? -eq 1 ]

umask 022
mkdir -p "$dir"
tar -xzf "$archive" -C "$dir" --strip-components=1 --no-same-owner --no-same-permissions
cd "$dir"
other=$(find . ! -type f ! -type d)
if [ -n "$other" ]; then
	echo "check-source: the archive holds entries that are not files or directories: $other" >&2
	exit 1
fi
nl='
'
cr=$(printf '\r')
odd=$(find . -name "*$nl*" -o -name "*$cr*" -o -name '*\\*')
if [ -n "$odd" ]; then
	echo "check-source: the archive holds a path with a newline, a carriage return or a backslash" >&2
	exit 1
fi

# "<sha256>  ./<path>" per file, then one listing line per entry.
find . -type f -print0 | xargs -0 -r sha256sum -- >"$lists/sums"
find . -mindepth 1 -printf '%y %m %P\n' >"$lists/entries"
awk '
	NR == FNR { sum[substr($0, 69)] = substr($0, 1, 64); next }
	{
		path = $0
		sub(/^[^ ]+ [^ ]+ /, "", path)
		if ($1 == "d") { print "d", $2, "-", path; next }
		if (!(path in sum)) { print "check-source: no sha256 for " path > "/dev/stderr"; exit 1 }
		print "f", $2, sum[path], path
	}
' "$lists/sums" "$lists/entries" >"$lists/unsorted"
LC_ALL=C sort -t ' ' -k4 "$lists/unsorted" >"$lists/listing"
count=$(wc -l <"$lists/listing")
if [ "$count" -eq 0 ]; then
	echo "check-source: the archive is empty" >&2
	exit 1
fi
have_sum=$(sha256sum <"$lists/listing" | cut -d' ' -f1)

digest=$(grep -E '^listing [0-9a-f]{64} [0-9]+$' "$lists/want" || true)
if [ -n "$digest" ]; then
	if [ "$(wc -l <"$lists/want")" -ne 1 ]; then
		echo "check-source: a digest manifest has exactly one line besides comments" >&2
		exit 1
	fi
	want_sum=$(echo "$digest" | cut -d' ' -f2)
	want_count=$(echo "$digest" | cut -d' ' -f3)
	if [ "$have_sum" != "$want_sum" ] || [ "$count" -ne "$want_count" ]; then
		cat "$lists/listing" >&2
		echo "check-source: the archive's listing (above) has sha256 $have_sum and $count entries;" \
			"the pinned tree's has $want_sum and $want_count" >&2
		exit 1
	fi
	echo "check-source: $count entries match the pinned tree (listing sha256 $have_sum)"
	exit 0
fi

if ! diff -u "$lists/want" "$lists/listing" >&2; then
	echo "check-source: the archive's entries differ from the pinned tree's (- manifest, + archive)" >&2
	exit 1
fi
echo "check-source: $count entries match the pinned tree"
