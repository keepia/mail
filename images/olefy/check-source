#!/bin/sh
# check-source: unpacks the olefy commit archive and checks that it holds
# exactly the files of the pinned commit (#44). ADD --checksum pins the
# archive's bytes; this check ties those bytes to the reviewed git tree:
# olefy-source.sha256 lists every file of the commit with its sha256,
# taken from a clone of HeinleinSupport/olefy at that commit.
#
# Usage: check-source ARCHIVE MANIFEST DIR
# Unpacks ARCHIVE into DIR (without the archive's top directory), then
# fails unless every file in MANIFEST has its sum and DIR holds no other
# file. The Dockerfile bind-mounts it for one RUN, so it is not in the image.
set -eu

if [ $# -ne 3 ]; then
	echo "usage: check-source ARCHIVE MANIFEST DIR" >&2
	exit 2
fi
archive=$1 manifest=$2 dir=$3

mkdir -p "$dir"
tar -xzf "$archive" -C "$dir" --strip-components=1 --no-same-owner
cd "$dir"
sha256sum --strict --quiet -c "$manifest"
want=$(awk '{ print $2 }' "$manifest" | LC_ALL=C sort)
have=$(find . -type f | sed 's|^\./||' | LC_ALL=C sort)
if [ "$want" != "$have" ]; then
	echo "check-source: the archive's files differ from the pinned commit's" >&2
	echo "want:" >&2
	echo "$want" >&2
	echo "have:" >&2
	echo "$have" >&2
	exit 1
fi
other=$(find . ! -type f ! -type d)
if [ -n "$other" ]; then
	echo "check-source: the archive holds entries that are not files: $other" >&2
	exit 1
fi
echo "check-source: $(echo "$have" | wc -l) files match the pinned commit"
