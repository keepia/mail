#!/bin/sh
# km: run keepia-mail commands through Docker Compose.
#
#   ./km migrate
#   ./km migrate status
#
# Starts PostgreSQL (Compose service postgres) and the Compose service
# keepia if needed, then runs `keepia-mail <arguments>` in the running
# keepia container. km never builds an image (#56) and pulls only upstream
# images pinned by digest: the own images are built only by `make images`
# or CI's checked build. If one of them is not in the local Docker store,
# km stops before starting anything and names `make images`. Docker
# Compose's progress output is hidden. The exit status is the command's.
# CI's test 7 runs km under `sh -x` and logs the trace: never expand a
# secret in a shell word here.
set -eu

cd "$(dirname "$0")"

# A daemon that cannot be reached is not a missing image: stop with
# docker's own error.
if ! docker version --format '{{.Server.Version}}' >/dev/null; then
	echo "km: the Docker daemon is not reachable (see docker's error above)." >&2
	exit 1
fi

# The images of postgres, keepia and every service they depend on, one
# per line. Assigned on its own, so that set -e stops km when config
# fails.
images=$(docker compose --progress quiet config --images postgres keepia)
set -f
for image in $images; do
	if docker image inspect -- "$image" >/dev/null 2>&1; then
		continue
	fi
	case $image in
	*@sha256:*)
		# Upstream, pinned by digest: a pull by digest is content-addressed.
		if ! docker pull -q -- "$image" >/dev/null; then
			echo "km: could not pull $image (see docker's error above)." >&2
			exit 1
		fi
		;;
	*)
		echo "km: the image $image (Compose service postgres or keepia, or a service they depend on) is missing." >&2
		echo "km: build it with \`make images\`; km does not build or pull images." >&2
		exit 1
		;;
	esac
done
set +f

# Every image is now in the local store, so neither up builds or pulls.
docker compose --progress quiet up -d --wait --no-build --pull never postgres
docker compose --progress quiet up -d --no-build --pull never keepia
exec docker compose --progress quiet exec -T keepia keepia-mail "$@"
