#!/bin/sh
# km: run keepia-mail commands through Docker Compose.
#
#   ./km migrate
#   ./km migrate status
#
# Starts PostgreSQL (Compose service postgres) and the Compose service
# keepia if needed, then runs `keepia-mail <arguments>` in the running
# keepia container. km never builds an image (#56) and never pulls the
# images of keepia or the services it depends on: they are built only by
# `make images` or CI's checked build. If one of them is not in the local
# Docker store, km stops before starting anything and names `make images`.
# Docker Compose's progress output is hidden. The exit status is the
# command's.
set -eu

cd "$(dirname "$0")"

# A daemon that cannot be reached is not a missing image: stop with
# docker's own error.
if ! docker version --format '{{.Server.Version}}' >/dev/null; then
	echo "km: the Docker daemon is not reachable (see docker's error above)." >&2
	exit 1
fi

# The images of keepia and of every service it depends on, one per line.
# Assigned on its own, so that set -e stops km when config fails.
images=$(docker compose --progress quiet config --images keepia)
set -f
for image in $images; do
	case $image in
	*@sha256:*) continue ;; # upstream, pinned by digest: up may pull it
	esac
	if ! docker image inspect -- "$image" >/dev/null 2>&1; then
		echo "km: the image $image (Compose service keepia or a service it depends on) is missing." >&2
		echo "km: build it with \`make images\`; km does not build or pull images." >&2
		exit 1
	fi
done
set +f

# postgres is an upstream image pinned by digest, so its up may pull it:
# a pull by digest is content-addressed. keepia and the services it
# depends on start only from images already in the local store.
docker compose --progress quiet up -d --wait --no-build postgres
docker compose --progress quiet up -d --no-build --pull never keepia
exec docker compose --progress quiet exec -T keepia keepia-mail "$@"
