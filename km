#!/bin/sh
# km: run keepia-mail commands through Docker Compose.
#
#   ./km migrate
#   ./km migrate status
#
# Starts PostgreSQL (Compose service postgres) if needed, then runs the
# command in a one-off container of the Compose service keepia, whose
# entrypoint is keepia-mail, and removes it afterwards. Next to a
# Dockerfile (a source checkout) it rebuilds the image first, fast when
# cached; in a release bundle it uses the released image. Docker Compose's
# progress output is hidden. The exit status is the command's.
set -eu

cd "$(dirname "$0")"

build=
if [ -f Dockerfile ]; then
	build=--build
fi

docker compose --progress quiet up -d --wait postgres
exec docker compose --progress quiet run --rm $build -T keepia "$@"
