#!/bin/sh
# km: run keepia-mail commands through Docker Compose.
#
#   ./km migrate
#   ./km migrate status
#
# Starts PostgreSQL (Compose service postgres) and the Compose service
# keepia if needed, then runs `keepia-mail <arguments>` in the running
# keepia container. km never builds an image (#56): images are built only
# by `make images` or CI's checked build. If the image of the service
# keepia is not in the local Docker store, km stops before starting
# anything and names `make images`. Docker Compose's progress output is
# hidden. The exit status is the command's.
set -eu

cd "$(dirname "$0")"

image=$(docker compose --progress quiet config --images keepia)
if ! docker image inspect "$image" >/dev/null 2>&1; then
	echo "km: the image $image of the Compose service keepia is missing." >&2
	echo "km: build it with \`make images\` in a source checkout (km does not build), or pull a released image." >&2
	exit 1
fi

docker compose --progress quiet up -d --wait --no-build postgres
docker compose --progress quiet up -d --no-build keepia
exec docker compose --progress quiet exec -T keepia keepia-mail "$@"
