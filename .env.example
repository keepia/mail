# Keepia Mail: the variables of docker-compose.yml. Copy this file to .env
# (which git ignores) and fill it in. Every value here is a placeholder;
# put no secret into this file.

# The roles this server runs. All five: the template "all roles on one
# server".
COMPOSE_PROFILES=control,edge,store,filter,groupware

# The edge addresses that port 25 is published to and that outbound mail
# leaves from (PTR and SPF name them). These are documentation addresses
# (RFC 5737, RFC 3849): replace them with this server's own. A wildcard
# (0.0.0.0, ::, and their other spellings) would publish port 25 on every
# interface: the edge role refuses to start with one (edge-addresses).
EDGE_IPV4=192.0.2.10
EDGE_IPV6=2001:db8::10

# The host name Postfix greets with.
KEEPIA_HOSTNAME=mail.example.org

# The PostgreSQL password of the keepia user. Required: without it the
# database is not created. URL-safe characters only (letters, digits,
# - . _ ~), because it becomes part of the database URL. Generate one, for
# example with `openssl rand -hex 24`.
KEEPIA_POSTGRES_PASSWORD=

# The own images: ${KEEPIA_REGISTRY}/mail*:${KEEPIA_VERSION}. `make images`
# tags its build $(REGISTRY)/mail*:$(VERSION) (default VERSION: git
# describe), so a local build needs the same values here, for example
# `make images VERSION=dev`.
KEEPIA_REGISTRY=ghcr.io/keepia
KEEPIA_VERSION=dev

# The private networks: KEEPIA_SUBNET4 is the first two octets of the IPv4
# /24s (<prefix>.<n>.0/24), KEEPIA_SUBNET6 the first three groups of the
# IPv6 /64s (<prefix>:<n>::/64, a unique local address). Change them only
# if they collide with a network of this host.
KEEPIA_SUBNET4=172.29
KEEPIA_SUBNET6=fd7c:3b9e:5a21

# Container logs go to journald; set the host's journald retention to 30
# days (architecture section 7). Use `local` on a host without journald.
KEEPIA_LOG_DRIVER=journald
